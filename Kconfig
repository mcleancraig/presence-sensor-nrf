# OpenThread SED + Home Assistant MQTT mmWave Presence Sensor (HLK-LD2410S / HLK-LD2410C) Kconfig
#

mainmenu "OpenThread SED + Home Assistant MQTT mmWave Presence Sensor"

choice APP_RADAR_MODEL
	prompt "Hi-Link 24 GHz mmWave radar module model"
	default APP_RADAR_LD2410S

config APP_RADAR_LD2410S
	bool "HLK-LD2410S (3.3 V ultra-low-power, 115200 baud, 20x20 mm)"
	help
	  Hi-Link HLK-LD2410S 24 GHz ultra-low-power radar module powered from
	  3.3 V (P0.13 high-drive GPIO or 3V3), communicating at 115200 8N1 using
	  command 0x0070/0x007A and 5-byte minimal (6E..62) or standard frames,
	  with 0.70 m per range gate.

config APP_RADAR_LD2410C
	bool "HLK-LD2410C (5 V USB-C powered, 256000 baud, 16x22 mm)"
	help
	  Hi-Link HLK-LD2410C 24 GHz presence radar module powered from 5 V VBUS
	  (constant USB-C connection), communicating at 256000 8N1 (with automatic
	  115200 baud fallback) using command 0x0060 and standard/engineering
	  frames (F4 F3 F2 F1 .. AA .. 55 00 F8 F7 F6 F5), with 0.75 m per gate.

endchoice

config APP_HEARTBEAT_INTERVAL_SEC
	int "Periodic idle MQTT state refresh interval (seconds)"
	default 300
	help
	  Interval between periodic Home Assistant MQTT state refreshes when no
	  occupancy edge transitions occur. Occupancy state changes are always
	  transmitted immediately via fast-polled OpenThread MQTT publish.

config APP_THREAD_DATASET_TLV_HEX
	string "OpenThread Active Operational Dataset TLV hex string"
	default ""
	help
	  Active Operational Dataset TLV hex string for the local Thread network
	  (set in gitignored local.conf; never commit network keys to git).

config APP_MQTT_BROKER_IPV4
	string "Home Assistant Mosquitto MQTT broker IPv4 address (translated via NAT64)"
	default "192.168.41.250"
	help
	  IPv4 address of the Home Assistant MQTT broker. Translated to an IPv6
	  address at runtime using the OpenThread Border Router's /96 NAT64 prefix.

config APP_MQTT_BROKER_PORT
	int "Home Assistant MQTT broker TCP port"
	range 1 65535
	default 1883
	help
	  TCP port of the Home Assistant Mosquitto MQTT broker.

config APP_MQTT_USERNAME
	string "Home Assistant MQTT broker username"
	default ""
	help
	  MQTT broker username (set in gitignored local.conf).

config APP_MQTT_PASSWORD
	string "Home Assistant MQTT broker password"
	default ""
	help
	  MQTT broker password (set in gitignored local.conf; never commit to git).

config APP_MQTT_KEEPALIVE_SEC
	int "MQTT keepalive interval (seconds)"
	range 30 3600
	default 300
	help
	  MQTT keepalive interval in seconds for the persistent TCP/NAT64 session.

config APP_RADAR_POLL_INTERVAL_MS
	int "Fast UART radar poll interval for sub-second presence & distance updates (ms)"
	range 100 10000
	default 400
	help
	  Periodic interval in milliseconds at which uart0 wakes briefly (~60 ms at
	  8.0 Hz radar report rate) to sample HLK-LD2410S presence, motion, and
	  distance. Enables < 300 ms bathroom light-trigger latency even on 4-wire
	  hookups where OT2 (P0.17) is not wired.

config APP_OCCUPIED_DISTANCE_POLL_SEC
	int "Occupied target distance refresh interval (seconds)"
	range 1 300
	default 5
	help
	  Legacy/background seconds-granularity poll interval when OT2 is wired.

config APP_BATTERY_SAMPLE_INTERVAL_SEC
	int "Battery voltage sampling interval (seconds)"
	default 3600
	help
	  Interval between SAADC VDDH/5 battery voltage measurements.

config APP_RADAR_MAX_GATE
	int "HLK-LD2410S farthest detection distance gate (0.7 m per gate)"
	range 1 16
	default 3
	help
	  Sets the HLK-LD2410S farthest detection gate (0.70 m per gate).
	  Gate 3 = 2.10 m, sized for a ~3 m^3 bathroom (~1.5 x 1.5 x 2.2 m) so
	  radar energy does not penetrate drywall or doors into adjacent hallways.

config APP_RADAR_MIN_GATE
	int "HLK-LD2410S nearest detection distance gate"
	range 0 15
	default 0
	help
	  Sets the HLK-LD2410S nearest detection gate (0 = 0.0 m).

config APP_RADAR_HOLD_S
	int "HLK-LD2410S unoccupied delay / hold time (seconds)"
	range 10 120
	default 30
	help
	  Time in seconds the HLK-LD2410S keeps OT2 asserted after the last
	  detected micro-motion or breathing signature clears.

choice APP_BATTERY_SENSE
	prompt "Battery voltage sense method"
	default APP_BATTERY_SENSE_VDDH

config APP_BATTERY_SENSE_VDDH
	bool "Internal VDDH/5"
	help
	  Use when the 18650 cell is wired to the B+/BAT pad, which feeds the
	  nRF52840 VDDH pin directly (nice!nano v2 and SuperMini). No external
	  parts. Note that on the SuperMini VDDH rises while USB is charging.

config APP_BATTERY_SENSE_DIVIDER
	bool "External resistor divider on an analog input"
	help
	  The SuperMini's on-board divider is wired to P0.24, which is not an
	  analog input, so this needs an external divider.

endchoice

if APP_BATTERY_SENSE_DIVIDER

config APP_BATTERY_DIVIDER_AIN
	int "SAADC analog input (AINx) the divider midpoint is wired to"
	range 0 7
	default 5
	help
	  AIN0=P0.02 AIN1=P0.03 AIN2=P0.04 AIN3=P0.05
	  AIN4=P0.28 AIN5=P0.29 AIN6=P0.30 AIN7=P0.31

config APP_BATTERY_DIVIDER_R_TOP_OHMS
	int "Divider resistor from battery to midpoint (ohms)"
	default 806000

config APP_BATTERY_DIVIDER_R_BOTTOM_OHMS
	int "Divider resistor from midpoint to GND (ohms)"
	default 2000000

endif # APP_BATTERY_SENSE_DIVIDER

config APP_DEBUG_KEEP_ALIVE
	bool "Keep running after fatal errors, asserts and abort() (debug only)"
	help
	  Aborts only the failing thread so its error report can still be
	  logged. Never enable in a deployed build.

source "Kconfig.zephyr"
